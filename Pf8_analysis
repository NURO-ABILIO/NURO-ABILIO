        "# ============================================================\n",
        "# HUDSON FST AND HEATMAP\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "from matplotlib.colors import TwoSlopeNorm\n",
        "\n",
        "\n",
        "# Reuse the in-memory result, or load the CSV exported by the FST analysis.\n",
        "# The fst_results DataFrame is already available from the previous run.\n",
        "# if \"fst_results\" not in globals():\n",
        "#     fst_file = Path(\"mozambique_pairwise_fst.csv\")\n",
        "\n",
        "#     if not fst_file.exists():\n",
        "#         print(\n",
        "#             \"fst_results was not found and mozambique_pairwise_fst.csv does not exist. \"\n",
        "#             \"Run the FST analysis cell first.\n",
        "#         )\n",
        "#     else:\n",
        "#         fst_results = pd.read_csv(fst_file)\n",
        "\n",
        "if \"fst_results\" in globals():\n",
        "    required_columns = {\n",
        "        \"gene\",\n",
        "        \"region_1\",\n",
        "        \"region_2\",\n",
        "        \"fst_hudson\",\n",
        "    }\n",
        "\n",
        "    missing_columns = required_columns.difference(fst_results.columns)\n",
        "\n",
        "    if missing_columns:\n",
        "        raise KeyError(\n",
        "            \"fst_results is missing required columns: \"\n",
        "            f\"{sorted(missing_columns)}\"\n",
        "        )\n",
        "\n",
        "    # Display every pairwise FST result without truncation.\n",
        "    print(\"=\" * 80)\n",
        "    print(\"COMPLETE PAIRWISE HUDSON FST TABLE\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    with pd.option_context(\n",
        "        \"display.max_rows\", None,\n",
        "        \"display.max_columns\", None,\n",
        "        \"display.width\", 200,\n",
        "    ):\n",
        "        display(fst_results)\n",
        "\n",
        "    fst_for_plot = fst_results.copy()\n",
        "    fst_for_plot[\"fst_hudson\"] = pd.to_numeric(\n",
        "        fst_for_plot[\"fst_hudson\"],\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "    fst_for_plot = fst_for_plot.dropna(\n",
        "        subset=[\"gene\", \"region_1\", \"region_2\", \"fst_hudson\"]\n",
        "    )\n",
        "\n",
        "    if fst_for_plot.empty:\n",
        "        print(\"\\nNo finite FST values are available for the heatmap.\")\n",
        "    else:\n",
        "        for gene in fst_for_plot[\"gene\"].drop_duplicates():\n",
        "            gene_fst = fst_for_plot[fst_for_plot[\"gene\"].eq(gene)]\n",
        "            regions = sorted(\n",
        "                set(gene_fst[\"region_1\"]) | set(gene_fst[\"region_2\"])\n",
        "            )\n",
        "\n",
        "            fst_matrix = pd.DataFrame(\n",
        "                np.nan,\n",
        "                index=regions,\n",
        "                columns=regions,\n",
        "                dtype=float,\n",
        "            )\n",
        "\n",
        "            for row in gene_fst.itertuples(index=False):\n",
        "                fst_matrix.loc[row.region_1, row.region_2] = row.fst_hudson\n",
        "                fst_matrix.loc[row.region_2, row.region_1] = row.fst_hudson\n",
        "\n",
        "            np.fill_diagonal(fst_matrix.values, 0.0)\n",
        "            matrix_values = fst_matrix.to_numpy()\n",
        "            finite_values = matrix_values[np.isfinite(matrix_values)]\n",
        "            maximum_abs_fst = max(\n",
        "                float(np.max(np.abs(finite_values)))\n",
        "                if finite_values.size\n",
        "                else 0.0,\n",
        "                0.01,\n",
        "            )\n",
        "\n",
        "            figure_size = max(8, min(18, 0.65 * len(regions) + 4))\n",
        "            figure, axis = plt.subplots(\n",
        "                figsize=(figure_size, figure_size)\n",
        "            )\n",
        "            image = axis.imshow(\n",
        "                matrix_values,\n",
        "                cmap=\"RdBu_r\",\n",
        "                norm=TwoSlopeNorm(\n",
        "                    vmin=-maximum_abs_fst,\n",
        "                    vcenter=0.0,\n",
        "                    vmax=maximum_abs_fst,\n",
        "                ),\n",
        "            )\n",
        "\n",
        "            axis.set_xticks(np.arange(len(regions)))\n",
        "            axis.set_yticks(np.arange(len(regions)))\n",
        "            axis.set_xticklabels(regions, rotation=45, ha=\"right\")\n",
        "            axis.set_yticklabels(regions)\n",
        "            axis.set_xlabel(\"Region\")\n",
        "            axis.set_ylabel(\"Region\")\n",
        "            axis.set_title(f\"Pairwise Hudson FST heatmap - {gene}\")\n",
        "\n",
        "            for row_index in range(len(regions)):\n",
        "                for column_index in range(len(regions)):\n",
        "                    value = matrix_values[row_index, column_index]\n",
        "                    if np.isfinite(value):\n",
        "                        axis.text(\n",
        "                            column_index,\n",
        "                            row_index,\n",
        "                            f\"{value:.3f}\",\n",
        "                            ha=\"center\",\n",
        "                            va=\"center\",\n",
        "                            fontsize=8,\n",
        "                        )\n",
        "\n",
        "            colorbar = figure.colorbar(image, ax=axis, fraction=0.046, pad=0.04)\n",
        "            colorbar.set_label(\"Hudson FST\")\n",
        "            axis.set_aspect(\"equal\")\n",
        "            figure.tight_layout()\n",
        "            plt.show()\n",
        "\n",
        "            print(\n",
        "                f\"{gene}: {len(gene_fst)} pairwise estimates, \"\n",
        "                f\"{len(regions)} regions.\"\n",
        "            )\n"
