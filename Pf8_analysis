        "        \"the number of Mozambique metadata records.\"\n",
        "    )\n",
        "\n",
        "chrom_data = np.asarray(\n",
        "    variant_dataset_moz_extended[\n",
        "        \"variant_chrom\"\n",
        "    ].compute()\n",
        ")\n",
        "\n",
        "pos_data = np.asarray(\n",
        "    variant_dataset_moz_extended[\n",
        "        \"variant_position\"\n",
        "    ].compute()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Total variants:\",\n",
        "    variant_dataset_moz_extended.sizes[\"variants\"],\n",
        ")\n",
        "\n",
        "print(\n",
