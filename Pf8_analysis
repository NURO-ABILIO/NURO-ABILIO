        "\n",
        "        valid_calls = variant_calls[\n",
        "            variant_calls >= 0\n",
        "        ]\n",
        "\n",
        "        if valid_calls.size == 0:\n",
        "            allele_frequency_per_variant.append(\n",
        "                np.nan\n",
        "            )\n",
        "\n",
        "        else:\n",
        "            allele_frequency_per_variant.append(\n",
        "                np.mean(valid_calls > 0)\n",
        "            )\n",
        "\n",
        "    allele_frequency_per_variant = np.asarray(\n",
        "        allele_frequency_per_variant,\n",
        "        dtype=float,\n",
        "    )\n",
        "\n",
        "    valid_af = allele_frequency_per_variant[\n",
        "        np.isfinite(\n",
        "            allele_frequency_per_variant\n",
        "        )\n",
        "    ]\n",
        "\n",
        "    if valid_af.size:\n",
        "\n",
        "        minimum_af = float(\n",
        "            valid_af.min()\n",
        "        )\n",
        "\n",
        "        maximum_af = float(\n",
        "            valid_af.max()\n",
        "        )\n",
        "\n",
        "        mean_af = float(\n",
        "            valid_af.mean()\n",
        "        )\n",
        "\n",
        "        median_af = float(\n",
        "            np.median(valid_af)\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Variant AF range: \"\n",
        "            f\"{minimum_af:.4f}-\"\n",
        "            f\"{maximum_af:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Mean variant AF: {mean_af:.4f}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Median variant AF: \"\n",
        "            f\"{median_af:.4f}\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "        minimum_af = np.nan\n",
        "        maximum_af = np.nan\n",
        "        mean_af = np.nan\n",
        "        median_af = np.nan\n",
        "\n",
        "        print(\n",
        "            \"No valid variant-level allele \"\n",
        "            \"frequencies were found.\"\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 7D. PCA POPULATION-STRUCTURE SUMMARY\n",
        "    # ========================================================\n",
        "\n",
        "    # samples × variants\n",
        "    dosage = haploid_genotypes.T.astype(\n",
        "        float\n",
        "    )\n",
        "\n",
        "    dosage[dosage < 0] = np.nan\n",
        "\n",
        "    # Retain variants called in more than 50% of samples\n",
        "    sufficient_calls = (\n",
        "        np.isfinite(dosage)\n",
        "        .mean(axis=0)\n",
        "        > 0.50\n",
        "    )\n",
        "\n",
        "    dosage = dosage[:, sufficient_calls]\n",
        "\n",
        "    if dosage.shape[1] > 0:\n",
        "\n",
        "        # Remove invariant sites\n",
        "        variant_std = np.nanstd(\n",
        "            dosage,\n",
        "            axis=0,\n",
        "        )\n",
        "\n",
        "        variable_sites = (\n",
        "            np.isfinite(variant_std)\n",
        "            & (variant_std > 0)\n",
        "        )\n",
        "\n",
        "        dosage = dosage[:, variable_sites]\n",
        "\n",
        "    if (\n",
        "        dosage.shape[0] >= 2\n",
        "        and dosage.shape[1] >= 2\n",
        "    ):\n",
        "\n",
        "        column_means = np.nanmean(\n",
        "            dosage,\n",
        "            axis=0,\n",
        "        )\n",
        "\n",
        "        X = np.where(\n",
        "            np.isfinite(dosage),\n",
        "            dosage,\n",
        "            column_means,\n",
        "        )\n",
        "\n",
        "        # Centre variants\n",
        "        X = X - X.mean(\n",
        "            axis=0,\n",
        "            keepdims=True,\n",
        "        )\n",
        "\n",
        "        number_components = min(\n",
        "            2,\n",
        "            X.shape[0],\n",
        "            X.shape[1],\n",
        "        )\n",
        "\n",
        "        pca = PCA(\n",
        "            n_components=number_components\n",
        "        )\n",
        "\n",
        "        coordinates = pca.fit_transform(X)\n",
        "\n",
        "        if number_components == 1:\n",
        "            coordinates = np.column_stack([\n",
        "                coordinates[:, 0],\n",
        "                np.zeros(len(coordinates)),\n",
        "            ])\n",
        "\n",
        "            explained_variance = np.array([\n",
        "                pca.explained_variance_ratio_[0],\n",
        "                0.0,\n",
        "            ])\n",
        "\n",
        "        else:\n",
        "            explained_variance = (\n",
        "                pca.explained_variance_ratio_\n",
        "            )\n",
        "\n",
        "        pca_table = pd.DataFrame({\n",
        "            \"sample_index\": np.arange(\n",
        "                len(coordinates)\n",
        "            ),\n",
        "            \"PC1\": coordinates[:, 0],\n",
        "            \"PC2\": coordinates[:, 1],\n",
        "        })\n",
        "\n",
        "        # Add available sample information\n",
        "        if \"Sample\" in mozambique_metadata.columns:\n",
        "            pca_table[\"Sample\"] = (\n",
        "                mozambique_metadata[\n",
        "                    \"Sample\"\n",
        "                ].astype(str).to_numpy()\n",
        "            )\n",
        "\n",
        "        if (\n",
        "            \"Admin level 1\"\n",
        "            in mozambique_metadata.columns\n",
        "        ):\n",
        "            pca_table[\"Region\"] = (\n",
        "                mozambique_metadata[\n",
        "                    \"Admin level 1\"\n",
        "                ]\n",
        "                .fillna(\"Unknown\")\n",
        "                .astype(str)\n",
        "                .to_numpy()\n",
        "            )\n",
        "        else:\n",
        "            pca_table[\"Region\"] = \"Unknown\"\n",
        "\n",
        "        pca_results[gene_name] = pca_table\n",
        "\n",
        "        print(\n",
        "            \"PCA variants used:\",\n",
        "            X.shape[1],\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Explained variance:\",\n",
        "            explained_variance,\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"First five PCA coordinates:\"\n",
        "        )\n",
        "\n",
        "        display(\n",
        "            pca_table.head()\n",
        "        )\n",
        "\n",
        "        plt.figure(figsize=(8, 6))\n",
        "\n",
        "        regions = pca_table[\n",
        "            \"Region\"\n",
        "        ].unique()\n",
        "\n",
        "        color_values = plt.cm.tab20(\n",
        "            np.linspace(\n",
        "                0,\n",
        "                1,\n",
        "                max(len(regions), 1),\n",
        "            )\n",
        "        )\n",
        "\n",
        "        for region, color in zip(\n",
        "            regions,\n",
        "            color_values,\n",
        "        ):\n",
        "            region_mask = (\n",
        "                pca_table[\"Region\"]\n",
        "                == region\n",
        "            )\n",
        "\n",
        "            plt.scatter(\n",
        "                pca_table.loc[\n",
        "                    region_mask,\n",
        "                    \"PC1\",\n",
        "                ],\n",
        "                pca_table.loc[\n",
        "                    region_mask,\n",
        "                    \"PC2\",\n",
        "                ],\n",
        "                s=25,\n",
        "                alpha=0.7,\n",
        "                color=color,\n",
        "                label=region,\n",
        "            )\n",
        "\n",
        "        plt.xlabel(\n",
        "            f\"PC1 \"\n",
        "            f\"({100 * explained_variance[0]:.2f}%)\"\n",
        "        )\n",
        "\n",
        "        plt.ylabel(\n",
        "            f\"PC2 \"\n",
        "            f\"({100 * explained_variance[1]:.2f}%)\"\n",
        "        )\n",
        "\n",
        "        plt.title(\n",
        "            f\"{gene_name} PCA — \"\n",
        "            \"Mozambique samples\"\n",
        "        )\n",
        "\n",
        "        plt.legend(\n",
        "            title=\"Admin level 1\",\n",
        "            bbox_to_anchor=(1.02, 1),\n",
        "            loc=\"upper left\",\n",
        "        )\n",
        "\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "    else:\n",
        "        print(\n",
        "            \"Not enough polymorphic variants \"\n",
        "            \"to perform PCA.\"\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 7E. SAVE GENE SUMMARY\n",
        "    # ========================================================\n",
        "\n",
        "    summary_rows.append({\n",
        "        \"gene\": gene_name,\n",
        "        \"gene_id\": gene_info[\"gene_id\"],\n",
        "        \"chromosome\": chromosome,\n",
        "        \"start\": start,\n",
        "        \"stop\": stop,\n",
        "        \"length_bp\": stop - start + 1,\n",
        "        \"number_variants\": number_raw_variants,\n",
        "        \"number_snps\": number_snps,\n",
        "        \"number_indels\": number_indels,\n",
        "        \"called_alleles\": number_called,\n",
        "        \"missing_calls\": number_missing,\n",
        "        \"missing_percentage\": missing_percentage,\n",
        "        \"reference_allele_count\": reference_count,\n",
        "        \"alternative_allele_count\": alternative_count,\n",
        "        \"reference_frequency\": reference_frequency,\n",
        "        \"alternative_frequency\": alternative_frequency,\n",
        "        \"minimum_variant_af\": minimum_af,\n",
        "        \"maximum_variant_af\": maximum_af,\n",
        "        \"mean_variant_af\": mean_af,\n",
        "        \"median_variant_af\": median_af,\n",
        "    })\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. DISPLAY SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "gene_summary = pd.DataFrame(\n",
        "    summary_rows\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 80)\n",
        "print(\"FINAL GENE-LEVEL SUMMARY\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "display(gene_summary)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. EXPORT RESULTS\n",
        "# ============================================================\n",
        "\n",
        "gene_summary.to_csv(\n",
        "    \"mozambique_expanded_gene_analysis.csv\",\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "for gene_name, pca_table in pca_results.items():\n",
        "\n",
        "    safe_gene_name = (\n",
        "        gene_name\n",
        "        .replace(\"-\", \"_\")\n",
        "        .replace(\" \", \"_\")\n",
        "        .lower()\n",
        "    )\n",
        "\n",
        "    pca_table.to_csv(\n",
        "        f\"mozambique_{safe_gene_name}_pca.csv\",\n",
        "        index=False,\n",
        "    )\n",
        "\n",
        "print(\"\\nAnalysis completed.\")\n",
        "print(\"Generated file:\")\n",
        "print(\"  mozambique_expanded_gene_analysis.csv\")\n",
        "\n",
        "for gene_name in pca_results:\n",
        "\n",
        "    safe_gene_name = (\n",
        "        gene_name\n",
        "        .replace(\"-\", \"_\")\n",
        "        .replace(\" \", \"_\")\n",
        "        .lower()\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"  mozambique_{safe_gene_name}_pca.csv\"\n",
        "    )"
      ]
    },
