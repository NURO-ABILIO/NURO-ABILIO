        "\n",
        "for gene_name, gene_info in genes.items():\n",
        "\n",
        "    chromosome = gene_info[\"chrom\"]\n",
        "    start = gene_info[\"start\"]\n",
        "    stop = gene_info[\"stop\"]\n",
        "\n",
        "    gene_mask = (\n",
        "        (chrom_data == chromosome)\n",
