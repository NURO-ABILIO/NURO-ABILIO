        " # ====================================================================================\n",
        "# Multiple Countries\n",
        "# =====================================================================================\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.decomposition import PCA\n",
        "import malariagen_data\n",
        "\n",
        "# Ensure pf8 connection and metadata are available\n",
        "if 'pf8' not in globals():\n",
        "    pf8 = malariagen_data.Pf8()\n",
        "\n",
        "if 'pf8_metadata' not in globals():\n",
        "    pf8_metadata = pf8.sample_metadata()\n",
        "\n",
        "# Define the countries to include in the analysis\n",
        "selected_countries_list = ['mozambique', 'mauritania', 'gambia', 'ghana', 'mali', 'burkina_faso', 'senegal', 'guinea', 'sierra_leone', 'cote_d_ivoire', 'nigeria', 'cameroon', 'gabon', 'democratic_republic_of_the_congo', 'uganda', 'kenya', 'tanzania', 'malawi', 'zambia', 'angola', 'ethiopia', 'madagascar', 'rwanda', 'burundi', 'benin', 'togo', 'sudan', 'south_sudan', 'eritrea', 'equatorial_guinea', 'republic_of_the_congo', 'central_african_republic', 'chad'] # Example countries\n",
        "\n",
        "# Filter samples from the selected countries\n",
        "loc_selected_samples = (\n",
        "    pf8_metadata[\"Country\"]\n",
        "    .fillna(\"\")\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.casefold()\n",
        "    .isin(selected_countries_list)\n",
        "    .to_numpy()\n",
        ")\n",
        "\n",
        "selected_metadata = (\n",
        "    pf8_metadata.loc[loc_selected_samples]\n",
        "    .reset_index(drop=True)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "if selected_metadata.empty:\n",
        "    raise ValueError(\"No samples found for the selected countries.\")\n",
        "\n",
        "print(f\"Selected samples from countries: {', '.join(selected_countries_list)}\")\n",
        "print(f\"Total selected samples: {len(selected_metadata)}\")\n",
        "\n",
        "# Load extended variant data for the selected samples\n",
        "# This can be memory intensive if many samples/variants are selected\n",
        "if 'variant_dataset_selected_extended' not in globals() or \\\n",
        "   not np.array_equal(variant_dataset_selected_extended.samples.values, selected_metadata['Sample'].values):\n",
        "    variant_dataset_selected_extended = (\n",
        "        pf8.variant_calls(extended=True)\n",
        "        .isel(samples=loc_selected_samples)\n",
        "    )\n",
        "\n",
        "chrom_data = np.asarray(\n",
        "    variant_dataset_selected_extended[\n",
        "        \"variant_chrom\"\n",
        "    ].compute()\n",
        ")\n",
        "\n",
        "pos_data = np.asarray(\n",
        "    variant_dataset_selected_extended[\n",
        "        \"variant_position\"\n",
        "    ].compute()\n",
        ")\n",
        "\n",
        "# Define the target genes again for clarity and independence\n",
        "genes = {\n",
        "    \"AP2-G\": {\"gene_id\": \"PF3D7_1222600\", \"chrom\": \"Pf3D7_12_v3\", \"start\": 907203, \"stop\": 914501},\n",
        "    \"HP1\": {\"gene_id\": \"PF3D7_1220900\", \"chrom\": \"Pf3D7_12_v3\", \"start\": 831252, \"stop\": 832052},\n",
        "    \"GDV1\": {\"gene_id\": \"PF3D7_0935400\", \"chrom\": \"Pf3D7_09_v3\", \"start\": 1377953, \"stop\": 1379752},\n",
        "}\n",
        "\n",
        "def convert_to_haploid(genotypes):\n",
        "    \"\"\"\n",
        "    Convert genotype calls to variants × samples.\n",
        "\n",
        "    P. falciparum blood-stage isolates are haploid.\n",
        "    If multiple allele copies are present, discordant calls\n",
        "    is treated as missing.\n",
        "    \"\"\"\n",
        "\n",
        "    genotype_array = np.asarray(genotypes)\n",
        "\n",
        "    if genotype_array.ndim != 3:\n",
        "        raise ValueError(\n",
        "            \"Unexpected genotype dimensions. Expected \"\n",
        "            \"variants × samples × ploidy.\"\n",
        "        )\n",
        "\n",
        "    haploid = genotype_array[:, :, 0].copy()\n",
        "\n",
        "    if genotype_array.shape[2] > 1:\n",
        "\n",
        "        discordant = np.any(\n",
        "            (genotype_array >= 0)\n",
        "            &\n",
        "            (\n",
        "                genotype_array\n",
        "                != genotype_array[:, :, [0]]\n",
        "            ),\n",
        "            axis=2,\n",
        "        )\n",
        "\n",
        "        haploid[discordant] = -1\n",
        "\n",
        "    return haploid\n",
        "\n",
        "\n",
        "# Iterate through each gene for separate PCA\n",
        "for gene_name, gene_info in genes.items():\n",
        "    print(f\"\\nProcessing gene for PCA: {gene_name}\")\n",
        "    chromosome = gene_info[\"chrom\"]\n",
        "    start = gene_info[\"start\"]\n",
        "    stop = gene_info[\"stop\"]\n",
        "\n",
        "    gene_mask = (\n",
        "        (chrom_data == chromosome)\n",
        "        &\n",
        "        (pos_data >= start)\n",
        "        &\n",
        "        (pos_data <= stop)\n",
        "    )\n",
        "\n",
        "    number_raw_variants = int(\n",
        "        gene_mask.sum()\n",
        "    )\n",
        "\n",
        "    if number_raw_variants == 0:\n",
        "        print(f\"  No variants found for {gene_name} in selected regions. Skipping PCA for this gene.\")\n",
        "        continue\n",
        "\n",
        "    gene_variants = (\n",
        "        variant_dataset_selected_extended\n",
        "        .isel(variants=gene_mask)\n",
        "    )\n",
        "\n",
        "    genotype_array = np.asarray(\n",
        "        gene_variants[\n",
        "            \"call_genotype\"\n",
        "        ].compute()\n",
        "    )\n",
        "\n",
        "    haploid_genotypes = convert_to_haploid(\n",
        "        genotype_array\n",
        "    )\n",
        "\n",
        "    # Transpose to samples x variants for PCA\n",
        "    gene_haplotypes = haploid_genotypes.T\n",
        "\n",
        "    print(f\"  Haplotypes shape for {gene_name}: {gene_haplotypes.shape}\")\n",
        "\n",
        "    # Prepare data for PCA\n",
        "    dosage = gene_haplotypes.astype(float)\n",
        "    dosage[dosage < 0] = np.nan # Treat missing genotypes as NaN\n",
        "\n",
        "    # Filter out variants with too many missing values\n",
        "    sufficient_calls = (\n",
        "        np.isfinite(dosage)\n",
        "        .mean(axis=0) > 0.50 # Keep variants called in more than 50% of samples\n",
        "    )\n",
        "    dosage = dosage[:, sufficient_calls]\n",
        "\n",
        "    # Filter out invariant sites\n",
        "    if dosage.shape[1] > 0:\n",
        "        variant_std = np.nanstd(dosage, axis=0)\n",
        "        variable_sites = (\n",
        "            np.isfinite(variant_std)\n",
        "            &\n",
        "            (variant_std > 0)\n",
        "        )\n",
        "        dosage = dosage[:, variable_sites]\n",
        "\n",
        "    print(f\"  Shape after filtering for PCA ({gene_name}): {dosage.shape}\")\n",
        "\n",
        "    if (dosage.shape[0] >= 2 and dosage.shape[1] >= 2):\n",
        "\n",
        "        # Impute missing values with the mean of each variant\n",
        "        column_means = np.nanmean(dosage, axis=0)\n",
        "        X = np.where(\n",
        "            np.isfinite(dosage),\n",
        "            dosage,\n",
        "            column_means,\n",
        "        )\n",
        "\n",
        "        # Center the variants\n",
        "        X = X - X.mean(axis=0, keepdims=True)\n",
        "\n",
        "        # Perform PCA\n",
        "        number_components = min(2, X.shape[0], X.shape[1])\n",
        "        pca = PCA(n_components=number_components)\n",
        "        coordinates = pca.fit_transform(X)\n",
        "\n",
        "        explained_variance = pca.explained_variance_ratio_\n",
        "\n",
        "        # Create a DataFrame for PCA results\n",
        "        pca_table = pd.DataFrame({\n",
        "            \"sample_index\": np.arange(len(coordinates)),\n",
        "            \"PC1\": coordinates[:, 0],\n",
        "            \"PC2\": coordinates[:, 1],\n",
        "        })\n",
        "\n",
        "        if \"Sample\" in selected_metadata.columns:\n",
        "            pca_table[\"Sample\"] = selected_metadata[\"Sample\"].astype(str).to_numpy()\n",
        "\n",
        "        # Use 'Country' for coloring\n",
        "        country_col = \"Country\"\n",
        "        if country_col in selected_metadata.columns:\n",
        "            pca_table[\"Country\"] = (\n",
        "                selected_metadata[country_col]\n",
        "                .fillna(\"Unknown\")\n",
        "                .astype(str)\n",
        "                .to_numpy()\n",
        "            )\n",
        "        else:\n",
        "            pca_table[\"Country\"] = \"Unknown\"\n",
        "\n",
        "        print(f\"  PCA variants used for {gene_name}: {X.shape[1]}\")\n",
        "        print(f\"  Explained variance for {gene_name}: {explained_variance}\")\n",
        "        print(f\"  First five PCA coordinates for {gene_name}:\")\n",
        "        display(pca_table.head())\n",
        "\n",
        "        # Plotting PCA results\n",
        "        plt.figure(figsize=(10, 8))\n",
        "        countries_to_plot = pca_table[\"Country\"].unique()\n",
        "        color_values = plt.cm.tab20(np.linspace(0, 1, max(len(countries_to_plot), 1)))\n",
        "\n",
        "        for country, color in zip(countries_to_plot, color_values):\n",
        "            country_mask = pca_table[\"Country\"] == country\n",
        "            plt.scatter(\n",
        "                pca_table.loc[country_mask, \"PC1\"],\n",
        "                pca_table.loc[country_mask, \"PC2\"],\n",
        "                s=50,\n",
        "                alpha=0.7,\n",
        "                color=color,\n",
        "                label=country,\n",
        "            )\n",
        "\n",
        "        plt.xlabel(f\"PC1 ({100 * explained_variance[0]:.2f}%) Kishan\")\n",
        "        plt.ylabel(f\"PC2 ({100 * explained_variance[1]:.2f}%) Kishan\")\n",
        "        plt.title(f\"PCA of {gene_name} Haplotypes — Multiple Countries Samples\")\n",
        "        plt.legend(title=country_col, bbox_to_anchor=(1.05, 1), loc=\"upper left\")\n",
        "        plt.grid(True, linestyle='--', alpha=0.6)\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "        # Save PCA results\n",
        "        safe_gene_name = gene_name.replace(\"-\", \"_\").lower()\n",
        "        # Modified filename to avoid 'File name too long' error\n",
        "        output_filename = f\"{safe_gene_name}_pca_multi_country.csv\"\n",
        "        pca_table.to_csv(\n",
        "            output_filename,\n",
        "            index=False,\n",
        "        )\n",
        "        print(f\"  Created: {output_filename}\")\n",
        "\n",
        "    else:\n",
        "        print(f\"  Not enough polymorphic variants for {gene_name} to perform PCA.\")"
