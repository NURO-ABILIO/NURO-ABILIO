        "    .reset_index(drop=True)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "n_mozambique = int(loc_mozambique.sum())\n",
        "\n",
        "if n_mozambique == 0:\n",
        "    raise ValueError(\n",
        "        \"No Mozambique samples were found in the metadata.\"\n",
        "    )\n",
        "\n",
        "print(\n",
        "    f\"Number of Mozambique samples: {n_mozambique}\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
