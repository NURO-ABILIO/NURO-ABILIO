      "source": [
        "# ============================================================\n",
        "# 2. SELECT HIGH-QUALITY MOZAMBIQUE SAMPLES\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import malariagen_data\n",
        "\n",
        "# Create the Pf8 connection if it does not already exist.\n",
        "if \"pf8\" not in globals():\n",
        "    pf8 = malariagen_data.Pf8()\n",
        "\n",
        "pf8_metadata = pf8.sample_metadata().copy()\n",
        "\n",
        "is_mozambique = (\n",
        "    pf8_metadata[\"Country\"]\n",
        "    .fillna(\"\")\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.casefold()\n",
        "    .eq(\"mozambique\")\n",
        ")\n",
        "\n",
        "# Use only samples that passed Pf8 quality control.\n",
        "if \"QC pass\" in pf8_metadata.columns:\n",
        "\n",
        "    qc_values = pf8_metadata[\"QC pass\"]\n",
        "\n",
        "    if pd.api.types.is_bool_dtype(qc_values):\n",
        "        passes_qc = qc_values.fillna(False)\n",
        "\n",
        "    else:\n",
        "        passes_qc = (\n",
        "            qc_values\n",
        "            .fillna(\"\")\n",
        "            .astype(str)\n",
        "            .str.strip()\n",
        "            .str.casefold()\n",
        "            .isin([\"true\", \"1\", \"yes\"])\n",
        "        )\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"WARNING: 'QC pass' was not found. \"\n",
        "        \"All Mozambique samples will be used.\"\n",
        "    )\n",
        "\n",
        "    passes_qc = pd.Series(\n",
        "        True,\n",
        "        index=pf8_metadata.index,\n",
        "    )\n",
        "\n",
        "loc_mozambique = (\n",
        "    is_mozambique & passes_qc\n",
        ").to_numpy()\n",
        "\n",
        "mozambique_metadata = (\n",
        "    pf8_metadata.loc[loc_mozambique]\n",
        "    .reset_index(drop=True)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "n_mozambique_total = int(\n",
        "    is_mozambique.sum()\n",
        ")\n",
        "\n",
        "n_mozambique = int(\n",
        "    loc_mozambique.sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"All Mozambique samples:\",\n",
        "    n_mozambique_total,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Mozambique samples passing QC:\",\n",
        "    n_mozambique,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Mozambique samples excluded:\",\n",
        "    n_mozambique_total - n_mozambique,\n",
        ")\n",
        "\n",
        "if n_mozambique == 0:\n",
        "    raise ValueError(\n",
        "        \"No Mozambique samples passed the \"\n",
        "        \"Pf8 quality-control filter.\"\n",
        "    )\n",
        "\n",
        "# Optional summary of genome callability.\n",
        "if \"% callable\" in mozambique_metadata.columns:\n",
        "\n",
        "    callable_percentage = pd.to_numeric(\n",
        "        mozambique_metadata[\"% callable\"],\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Median callable genome:\",\n",
        "        f\"{callable_percentage.median():.2f}%\",\n",
        "    )\n",
        "\n",
