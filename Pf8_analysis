      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# ============================================================\n",
        "# 1. TARGET GENES\n",
        "# ============================================================\n",
        "TARGET_GENES = {\n",
        "    \"AP2-G\": {\"chrom\": \"Pf3D7_12_v3\", \"start\": 906714, \"stop\": 914983},\n",
        "    \"HP1\":   {\"chrom\": \"Pf3D7_12_v3\", \"start\": 830802, \"stop\": 833569},\n",
        "    \"GDV1\":  {\"chrom\": \"Pf3D7_09_v3\", \"start\": 1377953, \"stop\": 1381134},\n",
        "    # You can add more genes here following the same format:\n",
        "    # \"GENE_NAME\": {\"chrom\": \"CHROM_ID\", \"start\": START_BP, \"stop\": STOP_BP},\n",
        "}\n",
        "\n",
        "# 2. INTERNAL HELPER FOR HAPLOID CONVERSION\n",
        "def to_haploid(gt_array):\n",
        "    h = gt_array[:, :, 0].copy()\n",
        "    if gt_array.shape[2] > 1:\n",
        "        discordant = np.any((gt_array >= 0) & (gt_array != gt_array[:, :, [0]]), axis=2)\n",
        "        h[discordant] = -1\n",
        "    return h\n",
        "\n",
        "# 3. EXECUTE PCA FOR ALL CONFIGURED GENES\n",
        "for gene_name, gene_info in TARGET_GENES.items():\n",
        "    print(f\"\\n{'='*40}\\nProcessing PCA for: {gene_name}\\n{'='*40}\")\n",
        "\n",
        "    # Use active_dataset from your Pipeline Control Center\n",
        "    ds = active_dataset\n",
        "    c = ds['variant_chrom'].values\n",
        "    p = ds['variant_position'].values\n",
        "\n",
        "    mask = (c == gene_info['chrom']) & (p >= gene_info['start']) & (p <= gene_info['stop'])\n",
        "\n",
        "    if mask.sum() < 2:\n",
        "        print(f\"Insufficient variants found for {gene_name} in the current dataset.\")\n",
        "        continue\n",
        "\n",
        "    gene_ds = ds.isel(variants=mask)\n",
        "    gt = to_haploid(gene_ds['call_genotype'].values).T\n",
        "\n",
        "    X = gt.astype(float)\n",
        "    X[X < 0] = np.nan\n",
        "\n",
        "    # Quality Filter: > 50% call rate and polymorphic within Mozambique\n",
        "    call_rate = np.isfinite(X).mean(axis=0)\n",
        "    polymorphic = np.nanstd(X, axis=0) > 0\n",
        "    X = X[:, (call_rate > 0.5) & polymorphic]\n",
        "\n",
        "    if X.shape[1] < 2:\n",
        "        print(f\"Not enough variants passed quality/polymorphism filters for {gene_name}.\")\n",
        "        continue\n",
        "\n",
        "    # Impute missing values (Mean Imputation) and Mean Centering\n",
        "    col_means = np.nanmean(X, axis=0)\n",
        "    X_imputed = np.where(np.isfinite(X), X, col_means)\n",
        "    X_imputed -= X_imputed.mean(axis=0)\n",
        "\n",
        "    # Run PCA\n",
        "    pca = PCA(n_components=2)\n",
        "    coords = pca.fit_transform(X_imputed)\n",
        "    evr = pca.explained_variance_ratio_\n",
        "\n",
        "    # Visualization\n",
        "    plt.figure(figsize=(10, 7))\n",
        "    current_sample_ids = ds.sample_id.values\n",
        "    region_map = pf8_metadata.set_index('Sample')['Admin level 1'].to_dict()\n",
        "    regions = np.array([region_map.get(sid, 'Unknown') for sid in current_sample_ids])\n",
        "\n",
        "    for region in np.unique(regions):\n",
        "        idx = (regions == region)\n",
        "        plt.scatter(coords[idx, 0], coords[idx, 1], label=region, alpha=0.7, s=50)\n",
        "\n",
        "    plt.title(f\"PCA: {gene_name} ({X.shape[1]} variants)\\nMozambique Population Structure\")\n",
        "    plt.xlabel(f\"PC1 ({evr[0]*100:.2f}%)\")\n",
        "    plt.ylabel(f\"PC2 ({evr[1]*100:.2f}%)\")\n",
        "    plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left', title='Admin Region')\n",
        "    plt.grid(True, linestyle=':', alpha=0.5)\n",
        "    plt.show()"
