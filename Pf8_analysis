      "source": [
        "# ============================================================\n",
        "# VARIANT COUNTS BY GENE — MOZAMBIQUE\n",
        "#\n",
        "# Reports:\n",
        "# 1. All Pf8 variants in each gene interval\n",
        "# 2. Variants called in Mozambique\n",
        "# 3. Variants with an alternative allele in Mozambique\n",
        "# 4. Variants polymorphic in Mozambique\n",
        "# 5. Pf8 PASS variants\n",
        "# 6. PASS variants polymorphic in Mozambique\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import malariagen_data\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. LOAD PF8\n",
        "# ============================================================\n",
        "\n",
        "pf8 = malariagen_data.Pf8()\n",
        "\n",
        "pf8_metadata = (\n",
        "    pf8.sample_metadata()\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. SELECT QC-PASSING MOZAMBIQUE SAMPLES\n",
        "# ============================================================\n",
        "\n",
        "is_mozambique = (\n",
        "    pf8_metadata[\"Country\"]\n",
        "    .fillna(\"\")\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.casefold()\n",
        "    .eq(\"mozambique\")\n",
        ")\n",
        "\n",
        "if \"QC pass\" in pf8_metadata.columns:\n",
        "\n",
        "    passes_qc = (\n",
        "        pf8_metadata[\"QC pass\"]\n",
        "        .fillna(False)\n",
        "        .astype(str)\n",
        "        .str.strip()\n",
        "        .str.casefold()\n",
        "        .isin([\n",
        "            \"true\",\n",
        "            \"1\",\n",
        "            \"yes\",\n",
        "        ])\n",
        "    )\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"WARNING: 'QC pass' was not found. \"\n",
        "        \"All Mozambique samples will be used.\"\n",
        "    )\n",
        "\n",
        "    passes_qc = pd.Series(\n",
        "        True,\n",
        "        index=pf8_metadata.index,\n",
        "    )\n",
        "\n",
        "sample_selection = (\n",
        "    is_mozambique\n",
        "    & passes_qc\n",
        ")\n",
        "\n",
        "loc_mozambique = (\n",
        "    sample_selection\n",
        "    .to_numpy(dtype=bool)\n",
        ")\n",
        "\n",
        "mozambique_metadata = (\n",
        "    pf8_metadata.loc[sample_selection]\n",
        "    .reset_index(drop=True)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "number_mozambique_before_qc = int(\n",
        "    is_mozambique.sum()\n",
        ")\n",
        "\n",
        "number_mozambique_after_qc = int(\n",
        "    len(mozambique_metadata)\n",
        ")\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"MOZAMBIQUE SAMPLE SELECTION\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    \"Mozambique samples before QC:\",\n",
        "    number_mozambique_before_qc,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Mozambique samples passing QC:\",\n",
        "    number_mozambique_after_qc,\n",
        ")\n",
        "\n",
        "if number_mozambique_after_qc == 0:\n",
        "    raise ValueError(\n",
        "        \"No QC-passing Mozambique samples were found.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. LOAD MOZAMBIQUE VARIANT CALLSET\n",
        "# ============================================================\n",
        "\n",
        "variant_dataset_mozambique = (\n",
        "    pf8.variant_calls(extended=True)\n",
        "    .isel(samples=loc_mozambique)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Callset samples:\",\n",
        "    variant_dataset_mozambique.sizes[\"samples\"],\n",
        ")\n",
        "\n",
        "if (\n",
        "    variant_dataset_mozambique.sizes[\"samples\"]\n",
        "    != number_mozambique_after_qc\n",
        "):\n",
        "    raise ValueError(\n",
        "        \"The genotype and metadata sample counts \"\n",
        "        \"do not match.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. LOAD VARIANT COORDINATES\n",
        "# ============================================================\n",
        "\n",
        "chrom_data = np.asarray(\n",
        "    variant_dataset_mozambique[\n",
        "        \"variant_chrom\"\n",
        "    ].compute()\n",
        ").astype(\"U\")\n",
        "\n",
        "pos_data = np.asarray(\n",
        "    variant_dataset_mozambique[\n",
        "        \"variant_position\"\n",
        "    ].compute()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. DEFINE GENES\n",
        "# ============================================================\n",
        "\n",
        "genes = {\n",
        "    \"AP2-G\": {\n",
        "        \"gene_id\": \"PF3D7_1222600\",\n",
        "        \"chrom\": \"Pf3D7_12_v3\",\n",
        "        \"start\": 906714,\n",
        "        \"stop\": 914983,\n",
        "    },\n",
        "    \"HP1\": {\n",
        "        \"gene_id\": \"PF3D7_1220900\",\n",
        "        \"chrom\": \"Pf3D7_12_v3\",\n",
        "        \"start\": 830802,\n",
        "        \"stop\": 833569,\n",
        "    },\n",
        "    \"GDV1\": {\n",
        "        \"gene_id\": \"PF3D7_0935400\",\n",
        "        \"chrom\": \"Pf3D7_09_v3\",\n",
        "        \"start\": 1377953,\n",
        "        \"stop\": 1381134,\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. COUNT VARIANTS FOR EACH GENE\n",
        "# ============================================================\n",
        "\n",
        "summary_rows = []\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"VARIANT COUNTS BY GENE\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "for gene_name, gene_info in genes.items():\n",
        "\n",
        "    chromosome = gene_info[\"chrom\"]\n",
        "    start = gene_info[\"start\"]\n",
        "    stop = gene_info[\"stop\"]\n",
        "\n",
        "    gene_mask = (\n",
        "        (chrom_data == chromosome)\n",
        "        & (pos_data >= start)\n",
        "        & (pos_data <= stop)\n",
        "    )\n",
        "\n",
        "    number_total_variants = int(\n",
        "        gene_mask.sum()\n",
        "    )\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 75)\n",
        "    print(gene_name)\n",
        "    print(\"-\" * 75)\n",
        "\n",
        "    print(\n",
        "        \"Gene ID:\",\n",
        "        gene_info[\"gene_id\"],\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Region: {chromosome}:\"\n",
        "        f\"{start:,}-{stop:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"All Pf8 variants in gene interval: \"\n",
        "        f\"{number_total_variants:,}\"\n",
        "    )\n",
        "\n",
        "    if number_total_variants == 0:\n",
        "\n",
        "        print(\n",
        "            \"No variants were found.\"\n",
        "        )\n",
        "\n",
        "        summary_rows.append({\n",
        "            \"gene\": gene_name,\n",
        "            \"gene_id\": gene_info[\"gene_id\"],\n",
        "            \"chromosome\": chromosome,\n",
        "            \"start\": start,\n",
        "            \"stop\": stop,\n",
        "            \"all_pf8_variants_in_interval\": 0,\n",
        "            \"called_in_mozambique\": 0,\n",
        "            \"alternative_observed_in_mozambique\": 0,\n",
        "            \"polymorphic_in_mozambique\": 0,\n",
        "            \"pf8_pass_variants\": 0,\n",
        "            \"pass_and_polymorphic_in_mozambique\": 0,\n",
        "        })\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 6A. EXTRACT GENE DATA\n",
        "    # ========================================================\n",
        "\n",
        "    gene_dataset = (\n",
        "        variant_dataset_mozambique\n",
        "        .isel(variants=gene_mask)\n",
        "    )\n",
        "\n",
        "    genotype_array = np.asarray(\n",
        "        gene_dataset[\n",
        "            \"call_genotype\"\n",
        "        ].compute()\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Genotype-array shape:\",\n",
        "        genotype_array.shape,\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 6B. IDENTIFY CALLED AND POLYMORPHIC VARIANTS\n",
        "    # ========================================================\n",
        "\n",
        "    called_allele = (\n",
        "        genotype_array >= 0\n",
        "    )\n",
        "\n",
        "    reference_allele = (\n",
        "        genotype_array == 0\n",
        "    )\n",
        "\n",
        "    alternative_allele = (\n",
        "        genotype_array > 0\n",
        "    )\n",
        "\n",
        "    # Called in at least one Mozambique sample.\n",
        "    called_in_mozambique = np.any(\n",
        "        called_allele,\n",
        "        axis=(1, 2),\n",
        "    )\n",
        "\n",
        "    # At least one alternative allele in Mozambique.\n",
        "    alternative_in_mozambique = np.any(\n",
        "        alternative_allele,\n",
        "        axis=(1, 2),\n",
        "    )\n",
        "\n",
        "    # Reference and alternative alleles both occur among\n",
        "    # Mozambique samples.\n",
        "    polymorphic_in_mozambique = (\n",
        "        np.any(\n",
        "            reference_allele,\n",
        "            axis=(1, 2),\n",
        "        )\n",
        "        & np.any(\n",
        "            alternative_allele,\n",
        "            axis=(1, 2),\n",
        "        )\n",
        "    )\n",
        "\n",
        "    number_called = int(\n",
        "        called_in_mozambique.sum()\n",
        "    )\n",
        "\n",
        "    number_alternative = int(\n",
        "        alternative_in_mozambique.sum()\n",
        "    )\n",
        "\n",
        "    number_polymorphic = int(\n",
        "        polymorphic_in_mozambique.sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 6C. APPLY PF8 PASS FILTER\n",
        "    # ========================================================\n",
        "\n",
        "    if \"variant_filter_pass\" in gene_dataset.variables:\n",
        "\n",
        "        variant_pass = np.asarray(\n",
        "            gene_dataset[\n",
        "                \"variant_filter_pass\"\n",
        "            ].compute(),\n",
        "            dtype=bool,\n",
        "        )\n",
        "\n",
        "        if variant_pass.ndim > 1:\n",
        "\n",
        "            variant_pass = np.all(\n",
        "                variant_pass,\n",
        "                axis=tuple(\n",
        "                    range(\n",
        "                        1,\n",
        "                        variant_pass.ndim,\n",
        "                    )\n",
        "                ),\n",
        "            )\n",
        "\n",
        "    else:\n",
        "        print(\n",
        "            \"WARNING: 'variant_filter_pass' was not found.\"\n",
        "        )\n",
        "\n",
        "        variant_pass = np.ones(\n",
        "            number_total_variants,\n",
        "            dtype=bool,\n",
        "        )\n",
        "\n",
        "    number_pass = int(\n",
        "        variant_pass.sum()\n",
        "    )\n",
        "\n",
        "    number_pass_polymorphic = int(\n",
        "        (\n",
        "            variant_pass\n",
        "            & polymorphic_in_mozambique\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 6D. PRINT RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    print(\n",
        "        f\"Called in at least one Mozambique sample: \"\n",
        "        f\"{number_called:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Alternative allele observed in Mozambique: \"\n",
        "        f\"{number_alternative:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Polymorphic in Mozambique: \"\n",
        "        f\"{number_polymorphic:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Pf8 PASS variants: \"\n",
        "        f\"{number_pass:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"PASS and polymorphic in Mozambique: \"\n",
        "        f\"{number_pass_polymorphic:,}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 6E. SAVE RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    summary_rows.append({\n",
        "        \"gene\": gene_name,\n",
        "        \"gene_id\": gene_info[\"gene_id\"],\n",
        "        \"chromosome\": chromosome,\n",
        "        \"start\": start,\n",
        "        \"stop\": stop,\n",
        "        \"all_pf8_variants_in_interval\": (\n",
        "            number_total_variants\n",
        "        ),\n",
        "        \"called_in_mozambique\": number_called,\n",
        "        \"alternative_observed_in_mozambique\": (\n",
        "            number_alternative\n",
        "        ),\n",
        "        \"polymorphic_in_mozambique\": (\n",
        "            number_polymorphic\n",
        "        ),\n",
        "        \"pf8_pass_variants\": number_pass,\n",
        "        \"pass_and_polymorphic_in_mozambique\": (\n",
        "            number_pass_polymorphic\n",
        "        ),\n",
        "    })\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. FINAL TABLE\n",
        "# ============================================================\n",
        "\n",
        "gene_variant_summary = pd.DataFrame(\n",
        "    summary_rows\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"FINAL VARIANT-COUNT SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "display(\n",
        "    gene_variant_summary\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. EXPORT RESULTS\n",
        "# ============================================================\n",
        "\n",
        "gene_variant_summary.to_csv(\n",
        "    \"mozambique_gene_variant_counts.csv\",\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nCreated: mozambique_gene_variant_counts.csv\"\n",
        ")"
      ]
    },
