        "import numpy as np\n",
        "import xarray as xr\n",
        "\n",
        "# 1. Apply the Variant Filter Pass\n",
        "# This formally subsets the variants to only those that passed MalariaGEN's internal filters.\n",
        "if 'variant_filter_pass' in variant_dataset_moz_extended.data_vars:\n",
        "    variant_mask = variant_dataset_moz_extended['variant_filter_pass'].values\n",
        "    clean_dataset = variant_dataset_moz_extended.isel(variants=variant_mask)\n",
        "    print(f\"Variants before filtering: {variant_dataset_moz_extended.sizes['variants']:,}\")\n",
        "    print(f\"Variants after filtering:  {clean_dataset.sizes['variants']:,}\")\n",
        "else:\n",
        "    print(\"variant_filter_pass not found in dataset.\")\n",
        "    clean_dataset = variant_dataset_moz_extended\n",
        "\n",
        "# 2. Evaluate DP/GQ impact on genotypes\n",
        "# Using the sampled variants (qc_variant_indices) to estimate genotype loss\n",
        "print(f\"\\nEvaluating thresholds (DP >= {DP_MIN}, GQ >= {GQ_MIN}):\")\n",
        "\n",
        "# Calculate a mask for genotypes that pass both thresholds\n",
        "pass_gq_dp = (gq_subset >= GQ_MIN) & (dp_subset >= DP_MIN) & (dp_subset <= DP_MAX)\n",
        "\n",
        "genotype_pass_rate = (pass_gq_dp.sum() / pass_gq_dp.size) * 100\n",
        "print(f\"Percentage of sampled genotypes passing all filters: {genotype_pass_rate:.2f}%\")\n",
        "\n",
        "# 3. Identify low-quality samples\n",
        "# Calculate call rate based on these thresholds per sample\n",
        "sample_threshold_pass_rate = pass_gq_dp.mean(axis=0) * 100\n",
        "low_qual_samples = np.sum(sample_threshold_pass_rate < 50) # Example: samples with <50% passing genotypes\n",
        "\n",
        "print(f\"Samples with <50% genotypes passing DP/GQ: {low_qual_samples} out of {number_genotype_samples}\")\n",
        "\n",
        "display(clean_dataset)"
