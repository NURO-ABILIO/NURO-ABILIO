      "source": [
        "# ============================================================\n",
        "# GENE-VARIATION SUMMARY — MOZAMBIQUE\n",
        "#\n",
        "# Genes:\n",
        "# - AP2-G\n",
        "# - HP1\n",
        "# - GDV1\n",
        "#\n",
        "# Uses:\n",
        "# - Mozambique samples only\n",
        "# - Pf8 QC-pass samples only\n",
        "# - One genotype call per variant/sample combination\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import malariagen_data\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. LOAD PF8\n",
        "# ============================================================\n",
        "\n",
        "pf8 = malariagen_data.Pf8()\n",
        "\n",
        "pf8_metadata = (\n",
        "    pf8.sample_metadata()\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. SELECT MOZAMBIQUE SAMPLES\n",
        "# ============================================================\n",
        "\n",
        "is_mozambique = (\n",
        "    pf8_metadata[\"Country\"]\n",
        "    .fillna(\"\")\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.casefold()\n",
        "    .eq(\"mozambique\")\n",
        ")\n",
        "\n",
        "number_mozambique_before_qc = int(\n",
        "    is_mozambique.sum()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. APPLY PF8 SAMPLE QC\n",
        "# ============================================================\n",
        "\n",
        "if \"QC pass\" in pf8_metadata.columns:\n",
        "\n",
        "    passes_qc = (\n",
        "        pf8_metadata[\"QC pass\"]\n",
        "        .fillna(False)\n",
        "        .astype(str)\n",
        "        .str.strip()\n",
        "        .str.casefold()\n",
        "        .isin([\n",
        "            \"true\",\n",
        "            \"1\",\n",
        "            \"yes\",\n",
        "        ])\n",
        "    )\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"WARNING: 'QC pass' was not found. \"\n",
        "        \"All Mozambique samples will be used.\"\n",
        "    )\n",
        "\n",
        "    passes_qc = pd.Series(\n",
        "        True,\n",
        "        index=pf8_metadata.index,\n",
        "    )\n",
        "\n",
        "sample_selection = (\n",
        "    is_mozambique\n",
        "    & passes_qc\n",
        ")\n",
        "\n",
        "loc_mozambique = (\n",
        "    sample_selection\n",
        "    .to_numpy(dtype=bool)\n",
        ")\n",
        "\n",
        "mozambique_metadata = (\n",
        "    pf8_metadata.loc[sample_selection]\n",
        "    .reset_index(drop=True)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "number_mozambique_after_qc = int(\n",
        "    len(mozambique_metadata)\n",
        ")\n",
        "\n",
        "if number_mozambique_after_qc == 0:\n",
        "    raise ValueError(\n",
        "        \"No QC-passing Mozambique samples were found.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. LOAD THE QC-FILTERED MOZAMBIQUE CALLSET\n",
        "# ============================================================\n",
        "\n",
        "# Deliberately recreate this variable instead of reusing an\n",
        "# object that may contain a previous sample selection.\n",
        "\n",
        "variant_dataset_moz_extended = (\n",
        "    pf8.variant_calls(extended=True)\n",
        "    .isel(samples=loc_mozambique)\n",
        ")\n",
        "\n",
        "number_callset_samples = int(\n",
        "    variant_dataset_moz_extended\n",
        "    .sizes[\"samples\"]\n",
        ")\n",
        "\n",
        "if (\n",
        "    number_callset_samples\n",
        "    != number_mozambique_after_qc\n",
        "):\n",
        "    raise ValueError(\n",
        "        \"The genotype sample count does not match \"\n",
        "        \"the metadata sample count.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. LOAD VARIANT COORDINATES\n",
        "# ============================================================\n",
        "\n",
        "chrom_data = np.asarray(\n",
        "    variant_dataset_moz_extended[\n",
        "        \"variant_chrom\"\n",
        "    ].compute()\n",
        ").astype(\"U\")\n",
        "\n",
        "pos_data = np.asarray(\n",
        "    variant_dataset_moz_extended[\n",
        "        \"variant_position\"\n",
        "    ].compute()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. DEFINE GENES\n",
        "# ============================================================\n",
        "\n",
        "genes_summary = {\n",
        "    \"AP2-G\": {\n",
        "        \"gene_id\": \"PF3D7_1222600\",\n",
        "        \"chrom\": \"Pf3D7_12_v3\",\n",
        "        \"start\": 906_714,\n",
        "        \"stop\": 914_983,\n",
        "    },\n",
        "    \"HP1\": {\n",
        "        \"gene_id\": \"PF3D7_1220900\",\n",
        "        \"chrom\": \"Pf3D7_12_v3\",\n",
        "        \"start\": 830_802,\n",
        "        \"stop\": 833_569,\n",
        "    },\n",
        "    \"GDV1\": {\n",
        "        \"gene_id\": \"PF3D7_0935400\",\n",
        "        \"chrom\": \"Pf3D7_09_v3\",\n",
        "        \"start\": 1_377_953,\n",
        "        \"stop\": 1_381_134,\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. DISPLAY SAMPLE SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "print(\"=\" * 75)\n",
        "print(\"GENE-VARIATION SUMMARY — MOZAMBIQUE ISOLATES\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "print(\n",
        "    \"Mozambique samples before QC:\",\n",
        "    number_mozambique_before_qc,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Mozambique samples passing QC:\",\n",
        "    number_mozambique_after_qc,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Samples excluded by QC:\",\n",
        "    number_mozambique_before_qc\n",
        "    - number_mozambique_after_qc,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Samples in genotype callset:\",\n",
        "    number_callset_samples,\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. ANALYZE EACH GENE\n",
        "# ============================================================\n",
        "\n",
        "summary_rows = []\n",
        "\n",
        "for gene_name, gene_info in genes_summary.items():\n",
        "\n",
        "    chromosome = gene_info[\"chrom\"]\n",
        "    start = gene_info[\"start\"]\n",
        "    stop = gene_info[\"stop\"]\n",
        "\n",
        "    gene_mask = (\n",
        "        (chrom_data == chromosome)\n",
        "        & (pos_data >= start)\n",
        "        & (pos_data <= stop)\n",
        "    )\n",
        "\n",
        "    number_variants = int(\n",
        "        gene_mask.sum()\n",
        "    )\n",
        "\n",
        "    print(\"\\n\" + \"-\" * 75)\n",
        "    print(gene_name)\n",
        "    print(\"-\" * 75)\n",
        "\n",
        "    print(\n",
        "        \"Gene ID:\",\n",
        "        gene_info[\"gene_id\"],\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Region: {chromosome}:\"\n",
        "        f\"{start:,}-{stop:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Variants found:\",\n",
        "        f\"{number_variants:,}\",\n",
        "    )\n",
        "\n",
        "    if number_variants == 0:\n",
        "\n",
        "        print(\n",
        "            \"No variants were found.\"\n",
        "        )\n",
        "\n",
        "        summary_rows.append({\n",
        "            \"gene\": gene_name,\n",
        "            \"gene_id\": gene_info[\"gene_id\"],\n",
        "            \"chromosome\": chromosome,\n",
        "            \"start\": start,\n",
        "            \"stop\": stop,\n",
        "            \"samples\": number_callset_samples,\n",
        "            \"variants\": 0,\n",
        "            \"total_genotypes\": 0,\n",
        "            \"homozygous_reference\": 0,\n",
        "            \"heterozygous\": 0,\n",
        "            \"homozygous_alternative\": 0,\n",
        "            \"missing\": 0,\n",
        "            \"call_rate_percentage\": np.nan,\n",
        "            \"missing_percentage\": np.nan,\n",
        "        })\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8A. LOAD GENE GENOTYPES\n",
        "    # ========================================================\n",
        "\n",
        "    gene_dataset = (\n",
        "        variant_dataset_moz_extended\n",
        "        .isel(variants=gene_mask)\n",
        "    )\n",
        "\n",
        "    genotype_array = np.asarray(\n",
        "        gene_dataset[\n",
        "            \"call_genotype\"\n",
        "        ].compute()\n",
        "    )\n",
        "\n",
        "    if genotype_array.ndim != 3:\n",
        "        raise ValueError(\n",
        "            f\"{gene_name}: expected genotype dimensions \"\n",
        "            \"variants × samples × ploidy.\"\n",
        "        )\n",
        "\n",
        "    observed_variants = int(\n",
        "        genotype_array.shape[0]\n",
        "    )\n",
        "\n",
        "    observed_samples = int(\n",
        "        genotype_array.shape[1]\n",
        "    )\n",
        "\n",
        "    ploidy = int(\n",
        "        genotype_array.shape[2]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Genotype-array shape:\",\n",
        "        genotype_array.shape,\n",
        "    )\n",
        "\n",
        "    if observed_variants != number_variants:\n",
        "        raise ValueError(\n",
        "            f\"{gene_name}: variant-count mismatch.\"\n",
        "        )\n",
        "\n",
        "    if observed_samples != number_callset_samples:\n",
        "        raise ValueError(\n",
        "            f\"{gene_name}: sample-count mismatch.\"\n",
        "        )\n",
        "\n",
        "    if ploidy < 2:\n",
        "        raise ValueError(\n",
        "            f\"{gene_name}: at least two stored allele \"\n",
        "            \"columns were expected.\"\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8B. CLASSIFY GENOTYPE CALLS\n",
        "    # ========================================================\n",
        "\n",
        "    allele_1 = genotype_array[:, :, 0]\n",
        "    allele_2 = genotype_array[:, :, 1]\n",
        "\n",
        "    # One genotype call corresponds to one variant/sample pair.\n",
        "    total_genotypes = (\n",
        "        observed_variants\n",
        "        * observed_samples\n",
        "    )\n",
        "\n",
        "    # A genotype is considered missing if either stored allele\n",
        "    # is negative.\n",
        "    missing_mask = (\n",
        "        (allele_1 < 0)\n",
        "        | (allele_2 < 0)\n",
        "    )\n",
        "\n",
        "    called_mask = (\n",
        "        ~missing_mask\n",
        "    )\n",
        "\n",
        "    homozygous_reference_mask = (\n",
        "        called_mask\n",
        "        & (allele_1 == 0)\n",
        "        & (allele_2 == 0)\n",
        "    )\n",
        "\n",
        "    heterozygous_mask = (\n",
        "        called_mask\n",
        "        & (allele_1 != allele_2)\n",
        "    )\n",
        "\n",
        "    homozygous_alternative_mask = (\n",
        "        called_mask\n",
        "        & (allele_1 == allele_2)\n",
        "        & (allele_1 > 0)\n",
        "    )\n",
        "\n",
        "    number_missing = int(\n",
        "        missing_mask.sum()\n",
        "    )\n",
        "\n",
        "    number_called = int(\n",
        "        called_mask.sum()\n",
        "    )\n",
        "\n",
        "    number_homozygous_reference = int(\n",
        "        homozygous_reference_mask.sum()\n",
        "    )\n",
        "\n",
        "    number_heterozygous = int(\n",
        "        heterozygous_mask.sum()\n",
        "    )\n",
        "\n",
        "    number_homozygous_alternative = int(\n",
        "        homozygous_alternative_mask.sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8C. VERIFY CLASSIFICATION\n",
        "    # ========================================================\n",
        "\n",
        "    classified_total = (\n",
        "        number_missing\n",
        "        + number_homozygous_reference\n",
        "        + number_heterozygous\n",
        "        + number_homozygous_alternative\n",
        "    )\n",
        "\n",
        "    if classified_total != total_genotypes:\n",
        "        raise ValueError(\n",
        "            f\"{gene_name}: genotype categories do not \"\n",
        "            \"sum to the expected total. \"\n",
        "            f\"{classified_total:,} != {total_genotypes:,}\"\n",
        "        )\n",
        "\n",
        "    expected_total = (\n",
        "        number_variants\n",
        "        * number_callset_samples\n",
        "    )\n",
        "\n",
        "    if total_genotypes != expected_total:\n",
        "        raise ValueError(\n",
        "            f\"{gene_name}: denominator error. \"\n",
        "            f\"{total_genotypes:,} != \"\n",
        "            f\"{number_variants:,} × \"\n",
        "            f\"{number_callset_samples:,}\"\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8D. CALCULATE PERCENTAGES\n",
        "    # ========================================================\n",
        "\n",
        "    missing_percentage = (\n",
        "        100\n",
        "        * number_missing\n",
        "        / total_genotypes\n",
        "    )\n",
        "\n",
        "    call_rate_percentage = (\n",
        "        100\n",
        "        * number_called\n",
        "        / total_genotypes\n",
        "    )\n",
        "\n",
        "    homozygous_reference_percentage = (\n",
        "        100\n",
        "        * number_homozygous_reference\n",
        "        / total_genotypes\n",
        "    )\n",
        "\n",
        "    heterozygous_percentage = (\n",
        "        100\n",
        "        * number_heterozygous\n",
        "        / total_genotypes\n",
        "    )\n",
        "\n",
        "    homozygous_alternative_percentage = (\n",
        "        100\n",
        "        * number_homozygous_alternative\n",
        "        / total_genotypes\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8E. PRINT RESULTS\n",
        "    # ========================================================\n",
        "\n",
        "    print(\n",
        "        f\"Expected genotype calls: \"\n",
        "        f\"{number_variants:,} variants × \"\n",
        "        f\"{number_callset_samples:,} samples = \"\n",
        "        f\"{total_genotypes:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Homozygous reference: \"\n",
        "        f\"{number_homozygous_reference:,} \"\n",
        "        f\"({homozygous_reference_percentage:.2f}%)\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Heterozygous: \"\n",
        "        f\"{number_heterozygous:,} \"\n",
        "        f\"({heterozygous_percentage:.2f}%)\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Homozygous alternative: \"\n",
        "        f\"{number_homozygous_alternative:,} \"\n",
        "        f\"({homozygous_alternative_percentage:.2f}%)\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Missing: \"\n",
        "        f\"{number_missing:,} / \"\n",
        "        f\"{total_genotypes:,} \"\n",
        "        f\"({missing_percentage:.2f}%)\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Called genotypes: \"\n",
        "        f\"{number_called:,} \"\n",
        "        f\"({call_rate_percentage:.2f}%)\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Classification check:\",\n",
        "        f\"{classified_total:,} == \"\n",
        "        f\"{total_genotypes:,}\",\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8F. DISPLAY FIRST POSITIONS\n",
        "    # ========================================================\n",
        "\n",
        "    gene_positions = np.asarray(\n",
        "        gene_dataset[\n",
        "            \"variant_position\"\n",
        "        ].compute()\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"First 10 positions:\",\n",
        "        sorted(\n",
        "            gene_positions.tolist()\n",
        "        )[:10],\n",
        "    )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # 8G. SAVE SUMMARY\n",
        "    # ========================================================\n",
        "\n",
        "    summary_rows.append({\n",
        "        \"gene\": gene_name,\n",
        "        \"gene_id\": gene_info[\"gene_id\"],\n",
        "        \"chromosome\": chromosome,\n",
        "        \"start\": start,\n",
        "        \"stop\": stop,\n",
        "        \"samples\": number_callset_samples,\n",
        "        \"variants\": number_variants,\n",
        "        \"total_genotypes\": total_genotypes,\n",
        "        \"homozygous_reference\": (\n",
        "            number_homozygous_reference\n",
        "        ),\n",
        "        \"homozygous_reference_percentage\": (\n",
        "            homozygous_reference_percentage\n",
        "        ),\n",
        "        \"heterozygous\": number_heterozygous,\n",
        "        \"heterozygous_percentage\": (\n",
        "            heterozygous_percentage\n",
        "        ),\n",
        "        \"homozygous_alternative\": (\n",
        "            number_homozygous_alternative\n",
        "        ),\n",
        "        \"homozygous_alternative_percentage\": (\n",
        "            homozygous_alternative_percentage\n",
        "        ),\n",
        "        \"missing\": number_missing,\n",
        "        \"missing_percentage\": missing_percentage,\n",
        "        \"called_genotypes\": number_called,\n",
        "        \"call_rate_percentage\": call_rate_percentage,\n",
        "    })\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. FINAL SUMMARY\n",
        "# ============================================================\n",
        "\n",
        "gene_variation_summary = pd.DataFrame(\n",
        "    summary_rows\n",
        ")\n",
        "\n",
        "print(\"\\n\" + \"=\" * 75)\n",
        "print(\"FINAL GENE-VARIATION SUMMARY\")\n",
        "print(\"=\" * 75)\n",
        "\n",
        "display(\n",
        "    gene_variation_summary\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. EXPORT RESULTS\n",
        "# ============================================================\n",
        "\n",
        "gene_variation_summary.to_csv(\n",
        "    \"mozambique_gene_variation_summary.csv\",\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nCreated: \"\n",
        "    \"mozambique_gene_variation_summary.csv\"\n",
        ")"
      ]
    },
