,\n        \"samples\": [\n          4770,\n          1543\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"called_in_mozambique\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1842,\n        \"min\": 1543,\n        \"max\": 4770,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          4770,\n          1543\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"alternative_observed_in_mozambique\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 517,\n        \"min\": 602,\n        \"max\": 1506,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          1506,\n          619\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"polymorphic_in_mozambique\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 516,\n        \"min\": 602,\n        \"max\": 1505,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          1505,\n          619\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"pf8_pass_variants\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1594,\n        \"min\": 988,\n        \"max\": 3867,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          3867,\n          988\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"pass_and_polymorphic_in_mozambique\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 464,\n        \"min\": 391,\n        \"max\": 1229,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          1229,\n          391\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
