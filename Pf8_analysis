        "\n",
        "    print(\n",
        "        f\"Gene length: {stop - start + 1:,} bp\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Variants found: {number_raw_variants}\"\n",
        "    )\n",
        "\n",
        "    if number_raw_variants == 0:\n",
        "\n",
        "        print(\n",
        "            \"No variants were found in this interval.\"\n",
        "        )\n",
        "\n",
        "        summary_rows.append({\n",
        "            \"gene\": gene_name,\n",
        "            \"gene_id\": gene_info[\"gene_id\"],\n",
        "            \"chromosome\": chromosome,\n",
        "            \"start\": start,\n",
