      "source": [
        "# Example: Frequency analysis using the 'active_dataset'\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "print(f\"Analyzing: {active_dataset.sizes['variants']:,} variants from {active_dataset.sizes['samples']} samples\")\n",
        "\n",
        "# Calculate Allele Frequency (AF) for a sample of variants to demonstrate the pipeline\n",
        "if 'variant_AF' in active_dataset.data_vars:\n",
        "    # Sampling variants for a quick histogram\n",
        "    # We flatten the array to handle multiple alternate alleles correctly in one distribution\n",
        "    af_data = active_dataset['variant_AF'].isel(variants=slice(0, 10000)).compute().values.flatten()\n",
        "\n",
        "    # Filter out NaNs which might occur if some alleles aren't present\n",
        "    af_data = af_data[~np.isnan(af_data)]\n",
        "\n",
        "    plt.figure(figsize=(8, 4))\n",
        "    plt.hist(af_data, bins=50, color='teal', edgecolor='white')\n",
        "    plt.title(\"Allele Frequency Distribution (Sampled Variants & Alleles)\")\n",
        "    plt.xlabel(\"Alternate Allele Frequency\")\n",
        "    plt.ylabel(\"Count\")\n",
        "    plt.grid(axis='y', alpha=0.3)\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"variant_AF not pre-computed. You can calculate it using active_dataset['call_genotype'].\")"
