        "import itertools\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import networkx as nx\n",
        "import allel\n",
        "import malariagen_data\n",
        "\n",
        "# Pf3D7 v3 coordinates (1-based, inclusive)\n",
        "TARGETS = {\n",
        "    \"AP2-G\": (\"Pf3D7_12_v3\", 906714, 914983),\n",
        "    \"HP1\":   (\"Pf3D7_12_v3\", 830802, 833569),\n",
        "    \"GDV1\":  (\"Pf3D7_09_v3\", 1377953, 1381134),\n",
        "}\n",
        "\n",
        "FLANK_BP = 20_000\n",
        "MIN_GROUP_N = 3\n",
        "MAX_MISSING_SITE = 0.10\n",
        "\n",
        "# ============================================================\n",
        "# 1. FUNCTION TO EXTRACT AND FILTER A GENOMIC REGION\n",
        "# ============================================================\n",
        "\n",
        "def get_region(chromosome, start, stop):\n",
        "    \"\"\"\n",
        "    Extract biallelic SNPs from a genomic interval using the active_dataset.\n",
        "    \"\"\"\n",
        "    # Use active_dataset if available, else fall back to the Mozambique subset\n",
        "    ds = globals().get('active_dataset', globals().get('variant_dataset_moz_extended'))\n",
        "\n",
        "    # Pre-fetch coordinates for masking\n",
        "    chrom_arr = ds[\"variant_chrom\"].values\n",
        "    pos_arr = ds[\"variant_position\"].values\n",
        "\n",
        "    region_mask = (\n",
        "        (chrom_arr == chromosome) &\n",
        "        (pos_arr >= start) &\n",
        "        (pos_arr <= stop)\n",
        "    )\n",
        "\n",
        "    n_raw_variants = int(region_mask.sum())\n",
        "    if n_raw_variants == 0:\n",
        "        return np.array([], dtype=int), allel.GenotypeArray(np.empty((0, ds.sizes['samples'], 2), dtype='i1'))\n",
        "\n",
        "    subset = ds.isel(variants=region_mask)\n",
        "    positions = subset[\"variant_position\"].values\n",
        "    genotype = allel.GenotypeArray(subset[\"call_genotype\"].values)\n",
        "\n",
        "    # Determine SNP status\n",
        "    if \"variant_is_snp\" in subset.data_vars:\n",
        "        is_snp = subset[\"variant_is_snp\"].values\n",
        "        if is_snp.ndim > 1: is_snp = np.all(is_snp, axis=tuple(range(1, is_snp.ndim)))\n",
        "    else:\n",
        "        is_snp = np.ones(len(positions), dtype=bool)\n",
        "\n",
        "    allele_counts = genotype.count_alleles(max_allele=1)\n",
        "    missing_fraction = (genotype < 0).any(axis=2).mean(axis=1)\n",
        "\n",
        "    keep = (is_snp & (allele_counts.sum(axis=1) > 0) & (missing_fraction <= MAX_MISSING_SITE))\n",
        "\n",
        "    return positions[keep], genotype.compress(keep, axis=0)\n",
        "\n",
        "def haploid_matrix(genotype):\n",
        "    genotype_array = np.asarray(genotype)\n",
        "    haplotypes = genotype_array[:, :, 0].copy()\n",
        "    if genotype_array.shape[2] > 1:\n",
        "        discordant = np.any((genotype_array >= 0) & (genotype_array != genotype_array[:, :, [0]]), axis=2)\n",
        "        haplotypes[discordant] = -1\n",
        "    return haplotypes\n",
        "\n",
        "def diversity_statistics(positions, genotype, start, stop):\n",
        "    if len(positions) == 0: return np.nan, np.nan, 0\n",
        "    allele_counts = genotype.count_alleles(max_allele=1)\n",
        "    segregating = allele_counts.is_segregating()\n",
        "    n_segregating = int(segregating.sum())\n",
        "    if n_segregating == 0: return 0.0, np.nan, 0\n",
        "\n",
        "    pi = allel.sequence_diversity(positions[segregating], allele_counts[segregating], start=start, stop=stop)\n",
        "    try:\n",
        "        tajima_d = allel.tajima_d(allele_counts[segregating], pos=positions[segregating], start=start, stop=stop)\n",
        "    except:\n",
        "        tajima_d = np.nan\n",
        "    return float(pi), float(tajima_d), n_segregating\n",
        "\n",
        "# Execute Analysis\n",
        "summary_rows = []\n",
        "for gene, (chrom, start, stop) in TARGETS.items():\n",
        "    pos, gt = get_region(chrom, start, stop)\n",
        "    pi, d, seg = diversity_statistics(pos, gt, start, stop)\n",
        "    summary_rows.append({\"gene\": gene, \"pi\": pi, \"tajimas_D\": d, \"segregating_sites\": seg})\n",
        "\n",
        "diversity_results = pd.DataFrame(summary_rows)\n",
        "display(diversity_results)"
      ]
