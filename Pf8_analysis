      "source": [
        "# ============================================================\n",
        "# QUALITY CONTROL FOR MOZAMBIQUE SAMPLES\n",
        "# DP, GQ, MQ, FILTER status and sample call rate\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import malariagen_data\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. LOAD DATA\n",
        "# ============================================================\n",
        "\n",
        "if \"pf8\" not in globals():\n",
        "    pf8 = malariagen_data.Pf8()\n",
        "\n",
        "if \"pf8_metadata\" not in globals():\n",
        "    pf8_metadata = pf8.sample_metadata()\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(\"QUALITY CONTROL FOR MOZAMBIQUE DATA\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. SELECT MOZAMBIQUE SAMPLES\n",
        "# ============================================================\n",
        "\n",
        "loc_mozambique = (\n",
        "    pf8_metadata[\"Country\"]\n",
        "    .fillna(\"\")\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.casefold()\n",
        "    .eq(\"mozambique\")\n",
        "    .to_numpy()\n",
        ")\n",
        "\n",
        "number_mozambique = int(loc_mozambique.sum())\n",
        "\n",
        "if number_mozambique == 0:\n",
        "    raise ValueError(\"No Mozambique samples were found.\")\n",
        "\n",
        "mozambique_metadata = (\n",
        "    pf8_metadata.loc[loc_mozambique]\n",
        "    .reset_index(drop=True)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "print(f\"Mozambique samples: {number_mozambique:,}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. LOAD EXTENDED VARIANT DATA\n",
        "# ============================================================\n",
        "\n",
        "if \"variant_dataset_moz_extended\" not in globals():\n",
        "\n",
        "    extended_dataset = pf8.variant_calls(\n",
        "        extended=True\n",
        "    )\n",
        "\n",
        "    variant_dataset_moz_extended = (\n",
        "        extended_dataset\n",
        "        .isel(samples=loc_mozambique)\n",
        "    )\n",
        "\n",
        "qc_dataset = variant_dataset_moz_extended\n",
        "\n",
        "number_total_variants = int(\n",
        "    qc_dataset.sizes[\"variants\"]\n",
        ")\n",
        "\n",
        "number_genotype_samples = int(\n",
        "    qc_dataset.sizes[\"samples\"]\n",
        ")\n",
        "\n",
        "if number_genotype_samples != number_mozambique:\n",
        "    raise ValueError(\n",
        "        \"The number of genotype samples does not match \"\n",
        "        \"the number of Mozambique metadata records.\"\n",
        "    )\n",
        "\n",
        "print(f\"Total variants: {number_total_variants:,}\")\n",
        "print(f\"Genotype samples: {number_genotype_samples:,}\")\n",
        "\n",
        "print(\"\\nAvailable variables:\")\n",
        "\n",
        "for variable_name in sorted(qc_dataset.data_vars):\n",
        "    print(f\"  {variable_name}\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. QC SETTINGS (max?, Ha[plotype caller usado, rever para minimo, olhando para o impacto. testar e optimizar (rever GQ \"30\"?))\n",
        "# ============================================================\n",
        "\n",
        "DP_MIN = 10\n",
        "DP_MAX = 100\n",
        "GQ_MIN = 20\n",
        "MQ_MIN = 30\n",
        "\n",
        "# DP, GQ and call-rate summaries use a distributed sample\n",
        "# of variants to reduce memory usage.\n",
        "MAX_QC_VARIANTS = 5_000\n",
        "\n",
        "number_qc_variants = min(\n",
        "    MAX_QC_VARIANTS,\n",
        "    number_total_variants,\n",
        ")\n",
        "\n",
        "if number_qc_variants == 0:\n",
        "    raise ValueError(\n",
        "        \"The dataset contains no variants.\"\n",
        "    )\n",
        "\n",
        "# Select evenly distributed variants across the genome.\n",
        "qc_variant_indices = np.linspace(\n",
        "    0,\n",
        "    number_total_variants - 1,\n",
        "    number_qc_variants,\n",
        "    dtype=int,\n",
        ")\n",
        "\n",
        "qc_variant_indices = np.unique(\n",
        "    qc_variant_indices\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nVariants sampled for DP, GQ and call rate: \"\n",
        "    f\"{len(qc_variant_indices):,}\"\n",
        ")\n",
        "\n",
        "# Extract call_DP from qc_dataset and select variants\n",
        "dp_subset = np.asarray(\n",
        "    qc_dataset[\"call_DP\"]\n",
        "    .isel(variants=qc_variant_indices)\n",
        "    .compute()\n",
        ").astype(float)\n",
        "\n",
        "# Create a mask for valid DP values (finite and non-negative)\n",
        "dp_valid_mask = (\n",
        "    np.isfinite(dp_subset)\n",
        "    & (dp_subset >= 0)\n",
        ")\n",
        "\n",
        "# Filter dp_subset to get only valid DP values\n",
        "valid_dp = dp_subset[\n",
        "    dp_valid_mask\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. HELPER FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "def numerical_summary(values):\n",
        "    \"\"\"Calculate a safe numerical summary.\"\"\"\n",
        "\n",
        "    values = np.asarray(\n",
        "        values,\n",
        "        dtype=float,\n",
        "    )\n",
        "\n",
        "    values = values[\n",
        "        np.isfinite(values)\n",
        "    ]\n",
        "\n",
        "    if values.size == 0:\n",
        "        return {\n",
        "            \"number_valid\": 0,\n",
        "            \"mean\": np.nan,\n",
        "            \"median\": np.nan,\n",
        "            \"minimum\": np.nan,\n",
        "            \"maximum\": np.nan,\n",
        "        }\n",
        "\n",
        "    return {\n",
        "        \"number_valid\": int(values.size),\n",
        "        \"mean\": float(np.mean(values)),\n",
        "        \"median\": float(np.median(values)),\n",
        "        \"minimum\": float(np.min(values)),\n",
        "        \"maximum\": float(np.max(values)),\n",
        "    }\n",
        "\n",
        "\n",
        "def print_summary(summary):\n",
        "    \"\"\"Print a numerical summary.\"\"\"\n",
        "\n",
        "    if summary[\"number_valid\"] == 0:\n",
        "        print(\"  No valid values were found.\")\n",
        "        return\n",
        "\n",
        "    print(\n",
        "        f\"  Valid values: \"\n",
        "        f\"{summary['number_valid']:,}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"  Mean: {summary['mean']:.2f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"  Median: {summary['median']:.2f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"  Minimum: {summary['minimum']:.2f}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"  Maximum: {summary['maximum']:.2f}\"\n",
        "    )\n",
        "\n",
        "\n",
        "def calculate_pass_rate(\n",
        "    pass_mask,\n",
        "    valid_mask,\n",
        "):\n",
        "    \"\"\"Calculate filter pass rate safely.\"\"\"\n",
        "\n",
        "    valid_count = int(\n",
        "        np.sum(valid_mask)\n",
        "    )\n",
        "\n",
        "    if valid_count == 0:\n",
        "        return np.nan, 0, 0\n",
        "\n",
        "    pass_count = int(\n",
        "        np.sum(\n",
        "            pass_mask & valid_mask\n",
        "        )\n",
        "    )\n",
        "\n",
        "    pass_rate = (\n",
        "        100 * pass_count / valid_count\n",
        "    )\n",
        "\n",
        "    return (\n",
        "        float(pass_rate),\n",
        "        pass_count,\n",
        "        valid_count,\n",
        "    )\n",
        "\n",
        "\n",
        "qc_summary_rows = []\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. DEPTH QC\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"-\" * 70)\n",
        "print(\"DEPTH — DP\")\n",
        "print(\"-\" * 70)\n",
        "\n",
        "if \"call_DP\" in qc_dataset.data_vars:\n",
        "\n",
        "    dp_summary = numerical_summary(\n",
        "        valid_dp\n",
        "    )\n",
        "\n",
        "    print_summary(dp_summary)\n",
        "\n",
        "    dp_pass_mask = (\n",
        "        (dp_subset >= DP_MIN)\n",
        "        & (dp_subset <= DP_MAX)\n",
        "    )\n",
        "\n",
        "    (\n",
        "        dp_pass_rate,\n",
        "        dp_pass_count,\n",
        "        dp_valid_count,\n",
        "    ) = calculate_pass_rate(\n",
        "        dp_pass_mask,\n",
        "        dp_valid_mask,\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"  Calls passing DP \"\n",
        "        f\"{DP_MIN}-{DP_MAX}: \"\n",
        "        f\"{dp_pass_count:,}/{dp_valid_count:,}\"\n",
        "    )\n",
        "\n",
        "    if np.isfinite(dp_pass_rate):\n",
        "        print(\n",
        "            f\"  DP pass rate: \"\n",
        "            f\"{dp_pass_rate:.2f}%\"\n",
        "        )\n",
        "    else:\n",
        "        print(\"  DP pass rate: unavailable\")\n",
        "\n",
        "    qc_summary_rows.append({\n",
        "        \"metric\": \"DP\",\n",
        "        \"level\": \"genotype call\",\n",
        "        \"number_valid\": dp_valid_count,\n",
        "        \"mean\": dp_summary[\"mean\"],\n",
        "        \"median\": dp_summary[\"median\"],\n",
        "        \"minimum\": dp_summary[\"minimum\"],\n",
        "        \"maximum\": dp_summary[\"maximum\"],\n",
        "        \"threshold\": f\"{DP_MIN} <= DP <= {DP_MAX}\",\n",
        "        \"number_pass\": dp_pass_count,\n",
        "        \"pass_rate_percent\": dp_pass_rate,\n",
        "    })\n",
        "\n",
        "    if valid_dp.size > 0:\n",
        "\n",
        "        fig, axes = plt.subplots(\n",
        "            ncols=2,\n",
        "            figsize=(16, 5),\n",
        "            sharey=False,\n",
        "        )\n",
        "\n",
        "        positive_dp = valid_dp[valid_dp > 0]\n",
        "\n",
        "        if positive_dp.size > 0:\n",
        "            log_bins = np.logspace(\n",
        "                np.log10(max(1.0, positive_dp.min())),\n",
        "                np.log10(max(10.0, positive_dp.max())),\n",
        "                50,\n",
        "            )\n",
        "\n",
        "            axes[0].hist(\n",
        "                positive_dp,\n",
        "                bins=log_bins,\n",
        "                color=\"steelblue\",\n",
        "                edgecolor=\"white\",\n",
        "            )\n",
        "            axes[0].set_xscale(\"log\")\n",
        "            axes[0].set_xlabel(\"Read depth (DP, log scale)\")\n",
        "            axes[0].set_ylabel(\"Number of genotype calls\")\n",
        "            axes[0].set_title(\"Read-depth distribution (log x-axis)\")\n",
        "            axes[0].set_xticks([1, 2, 5, 10, 20, 50, 100, 200, 500, 1000])\n",
        "            axes[0].get_xaxis().set_major_formatter(\n",
        "                plt.ScalarFormatter()\n",
        "            )\n",
        "            axes[0].get_xaxis().set_minor_formatter(plt.NullFormatter())\n",
        "            axes[0].tick_params(axis=\"x\", which=\"minor\", bottom=False)\n",
        "\n",
        "        else:\n",
        "            axes[0].text(\n",
        "                0.5,\n",
        "                0.5,\n",
        "                \"No positive DP values\",\n",
        "                transform=axes[0].transAxes,\n",
        "                ha=\"center\",\n",
        "                va=\"center\",\n",
        "            )\n",
        "            axes[0].set_axis_off()\n",
        "\n",
        "        upper_cutoff = np.percentile(valid_dp, 99)\n",
        "        axes[1].hist(\n",
        "            valid_dp[valid_dp <= upper_cutoff],\n",
        "            bins=50,\n",
        "            color=\"steelblue\",\n",
        "            edgecolor=\"white\",\n",
        "        )\n",
        "        axes[1].axvline(\n",
        "            DP_MIN,\n",
        "            color=\"red\",\n",
        "            linestyle=\"--\",\n",
        "            label=f\"Minimum DP = {DP_MIN}\",\n",
        "        )\n",
        "        axes[1].axvline(\n",
        "            DP_MAX,\n",
        "            color=\"darkorange\",\n",
        "            linestyle=\"--\",\n",
        "            label=f\"Maximum DP = {DP_MAX}\",\n",
        "        )\n",
        "        axes[1].axvline(\n",
        "            upper_cutoff,\n",
        "            color=\"black\",\n",
        "            linestyle=\"--\",\n",
        "            label=f\"99th percentile = {upper_cutoff:.0f}\",\n",
        "        )\n",
        "        axes[1].set_xlabel(\"Read depth (DP)\")\n",
        "        axes[1].set_title(\"Read-depth distribution (0-99th percentile)\")\n",
        "        axes[1].legend()\n",
        "\n",
        "        if np.any(valid_dp > upper_cutoff):\n",
        "            n_above = int(np.sum(valid_dp > upper_cutoff))\n",
        "            axes[1].text(\n",
        "                0.95,\n",
        "                0.95,\n",
        "                f\"{n_above:,} calls above 99th percentile\",\n",
        "                ha=\"right\",\n",
        "                va=\"top\",\n",
        "                transform=axes[1].transAxes,\n",
        "                fontsize=\"small\",\n",
        "            )\n",
