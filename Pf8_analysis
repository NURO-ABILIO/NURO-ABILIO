        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Helper to define haplotypes based on the active_dataset\n",
        "def get_haplotypes(gene_name, chrom, start, stop):\n",
        "    ds = active_dataset\n",
        "    # Fix: Compute the boolean mask to avoid Dask indexing limitations in Xarray\n",
        "    chrom_mask = (ds['variant_chrom'] == chrom).compute()\n",
        "    pos_mask = (ds['variant_position'] >= start).compute() & (ds['variant_position'] <= stop).compute()\n",
        "    mask = chrom_mask & pos_mask\n",
        "\n",
        "    # Convert boolean mask to integer indices for isel\n",
        "    indices = np.flatnonzero(mask)\n",
        "    subset = ds.isel(variants=indices)\n",
        "\n",
        "    # Convert to haploid (variants x samples)\n",
        "    gt = subset['call_genotype'].values\n",
        "    h = gt[:, :, 0].copy()\n",
        "    if gt.shape[2] > 1:\n",
        "        discordant = np.any((gt >= 0) & (gt != gt[:, :, [0]]), axis=2)\n",
        "        h[discordant] = -1\n",
        "\n",
        "    # Create a string representation for each sample's haplotype\n",
        "    sample_haplotypes = []\n",
        "    for i in range(h.shape[1]):\n",
        "        sample_haplotypes.append(\",\".join(map(str, h[:, i])))\n",
        "    return sample_haplotypes\n",
        "\n",
        "# 2. Calculate Haplotype Statistics\n",
        "haplo_rows = []\n",
        "for gene, info in TARGET_GENES.items():\n",
        "    haps = get_haplotypes(gene, info['chrom'], info['start'], info['stop'])\n",
        "    for h_str in haps:\n",
        "        haplo_rows.append({'gene': gene, 'haplotype': h_str})\n",
        "\n",
        "haplotype_results = pd.DataFrame(haplo_rows)\n",
        "print(f\"Haplotypes calculated for {len(TARGET_GENES)} genes.\")"
