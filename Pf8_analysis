        "\n",
        "# ============================================================\n",
        "# 6. HELPER FUNCTION FOR HAPLOID CALLS\n",
        "# ============================================================\n",
        "\n",
        "def convert_to_haploid(genotypes):\n",
        "    \"\"\"\n",
        "    Convert genotype calls to variants × samples.\n",
        "\n",
        "    P. falciparum blood-stage isolates are haploid.\n",
        "    If multiple allele copies are present, discordant calls\n",
        "    are treated as missing.\n",
        "    \"\"\"\n",
        "\n",
        "    genotype_array = np.asarray(genotypes)\n",
        "\n",
        "    if genotype_array.ndim != 3:\n",
        "        raise ValueError(\n",
        "            \"Unexpected genotype dimensions. Expected \"\n",
        "            \"variants × samples × ploidy.\"\n",
        "        )\n",
        "\n",
        "    haploid = genotype_array[:, :, 0].copy()\n",
        "\n",
        "    if genotype_array.shape[2] > 1:\n",
        "\n",
        "        discordant = np.any(\n",
        "            (genotype_array >= 0)\n",
        "            & (\n",
        "                genotype_array\n",
        "                != genotype_array[:, :, [0]]\n",
        "            ),\n",
        "            axis=2,\n",
        "        )\n",
        "\n",
        "        haploid[discordant] = -1\n",
        "\n",
        "    return haploid\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. RUN GENE-LEVEL ANALYSIS\n",
