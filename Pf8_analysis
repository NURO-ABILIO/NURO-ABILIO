        "# Summary of gene variations (concise version)=== NO NEED\n",
        "# Load coordinates directly so this cell can run independently.\n",
        "if 'pf8' not in globals():\n",
        "    import malariagen_data\n",
        "    pf8 = malariagen_data.Pf8()\n",
        "if 'pf8_metadata' not in globals():\n",
        "    pf8_metadata = pf8.sample_metadata()\n",
        "if 'variant_dataset_moz_extended' not in globals():\n",
        "    loc_mozambique = pf8_metadata.eval(\"Country == 'Mozambique'\").values\n",
        "    extended_dataset = pf8.variant_calls(extended=True)\n",
        "    variant_dataset_moz_extended = extended_dataset.isel(samples=loc_mozambique)\n",
        "\n",
        "chrom_data = variant_dataset_moz_extended[\"variant_chrom\"].compute().values\n",
        "pos_data = variant_dataset_moz_extended[\"variant_position\"].compute().values\n",
        "\n",
        "print(\"=\"*70)\n",
        "print(\"GENE VARIATION SUMMARY - MOZAMBIQUE ISOLATES\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "genes_summary = {\n",
        "    'AP2-G': {'chrom': 'Pf3D7_12_v3', 'start': 906714, 'stop': 914983},\n",
        "    'HP1': {'chrom': 'Pf3D7_12_v3', 'start': 830802, 'stop': 833569},\n",
        "    'GDV1': {'chrom': 'Pf3D7_09_v3', 'start': 1377653, 'stop': 1381134}\n",
        "}\n",
        "\n",
        "for gene_name, gene_info in genes_summary.items():\n",
        "    chrom = gene_info['chrom']\n",
        "    start = gene_info['start']\n",
        "    stop = gene_info['stop']\n",
        "\n",
        "    # Filter variants\n",
        "    gene_mask = (chrom_data == chrom) & (pos_data >= start) & (pos_data <= stop)\n",
        "    n_vars = int(gene_mask.sum())\n",
        "\n",
        "    print(f\"\\n{gene_name}: {n_vars} variants found\")\n",
        "\n",
        "    if n_vars > 0:\n",
        "        # Get data for this gene\n",
        "        gene_vars = variant_dataset_moz_extended.isel(variants=gene_mask)\n",
        "        gt = gene_vars[\"call_genotype\"].compute().values\n",
        "\n",
        "        # Calculate statistics\n",
        "        called = (gt[:, :, 0] >= 0) & (gt[:, :, 1] >= 0)\n",
        "        heterozygous = called & (gt[:, :, 0] != gt[:, :, 1])\n",
        "        homozygous_alt = called & (gt[:, :, 0] > 0) & (gt[:, :, 0] == gt[:, :, 1])\n",
        "        n_heterozygous = int(heterozygous.sum())\n",
        "        n_homozygous_alt = int(homozygous_alt.sum())\n",
        "        n_missing = int((~called).sum())\n",
        "        total_calls = called.size\n",
        "\n",
        "        print(f\"  Heterozygous: {n_heterozygous:,}\")\n",
        "        print(f\"  Homozygous Alt: {n_homozygous_alt:,}\")\n",
        "        print(f\"  Missing: {n_missing:,} / {total_calls:,}\")\n",
        "\n",
        "        # Get variant positions\n",
        "        var_pos = gene_vars[\"variant_position\"].compute().values\n",
        "        print(f\"  First 10 positions: {sorted(var_pos)[:10]}\")\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n"
      ]
