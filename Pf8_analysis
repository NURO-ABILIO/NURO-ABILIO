        "        )\n",
        "\n",
        "        number_snps = int(\n",
        "            is_snp.sum()\n",
        "        )\n",
        "\n",
        "        number_indels = int(\n",
        "            (~is_snp).sum()\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"SNPs: {number_snps}\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Indels/non-SNP variants: \"\n",
        "            f\"{number_indels}\"\n",
        "        )\n",
        "\n",
        "    else:\n",
        "        number_snps = np.nan\n",
        "        number_indels = np.nan\n",
        "\n",
        "        print(\n",
        "            \"SNP/indel annotation unavailable.\"\n",
        "        )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
